# Sao chép thành .env.local rồi điền giá trị từ Firebase console (Project settings > Your apps).
# .env.local đã nằm trong .gitignore (*.local).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=phienbangws
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key cho App Check (khóa công khai).
VITE_RECAPTCHA_SITE_KEY=
